# Flask Configuration
# Cambia esto a un valor seguro en producción
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False

# Database Configuration
# Ejemplo PostgreSQL: postgresql://user:password@host:port/dbname?connect_timeout=10&sslmode=prefer
# O SQLite: sqlite:///recuperacion_informacion.db
DATABASE_URL=postgresql://postgres:xxxxxxx@127.0.0.1:5432/dbRecuperacioIn?connect_timeout=10&sslmode=prefer

# Upload Configuration
# Carpeta donde se almacenarán los archivos cargados
UPLOAD_FOLDER=uploads
# Tamaño máximo en bytes (50 MB por defecto)
MAX_CONTENT_LENGTH=52428800

# Server Configuration
FLASK_ENV=production
FLASK_APP=app.py

